<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.1" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
  <persistence-unit name="ApiRestPeluPosPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
    <class>peluposbd.Factura</class>
    <class>peluposbd.Producto</class>
    <class>peluposbd.Usuario</class>
    <class>peluposbd.FacturaProducto</class>
    <class>peluposbd.FacturaServicio</class>
    <class>peluposbd.Empleado</class>
    <class>peluposbd.Cliente</class>
    <class>peluposbd.Servicio</class>
    <class>peluposbd.Local</class>
    <class>peluposbd.TokenVerificado</class>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/peluposbd?zeroDateTimeBehavior=CONVERT_TO_NULL?autoReconnect=true&amp;useSSL=false&amp;zeroDateTimeBehavior=convertToNull"/>
      <property name="jakarta.persistence.jdbc.user" value="root"/>
      <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
      <property name="jakarta.persistence.jdbc.password" value="1234"/>
      <property name="eclipselink.logging.level" value="OFF"/>
    </properties>
  </persistence-unit>
</persistence>
