<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorPrimary">#FF5B8DEF</Color>
    <Color x:Key="ColorAccent">#FF4ECDC4</Color>
    <Color x:Key="ColorBackground">#FFF7F9FC</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorBorder">#FFE5E9F2</Color>

    <Color x:Key="ColorTextPrimary">#FF2E2E2E</Color>
    <Color x:Key="ColorTextSecondary">#FF6E6E6E</Color>

    <Color x:Key="ColorSuccess">#FF4ECDC4</Color>
    <Color x:Key="ColorWarning">#FFFFB347</Color>
    <Color x:Key="ColorError">#FFFF6B6B</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource ColorBackground}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorder}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}"/>

    <Color x:Key="ColorPrimaryDark">#FF6DA9FF</Color>
    <Color x:Key="ColorAccentDark">#FF4ECDC4</Color>
    <Color x:Key="ColorBackgroundDark">#FF1C1F26</Color>
    <Color x:Key="ColorSurfaceDark">#FF2A2F3A</Color>
    <Color x:Key="ColorBorderDark">#FF3A4151</Color>

    <Color x:Key="ColorTextPrimaryDark">#FFFFFFFF</Color>
    <Color x:Key="ColorTextSecondaryDark">#FFC8CDD7</Color>

    <Color x:Key="ColorSuccessDark">#FF9CE5DC</Color>
    <Color x:Key="ColorWarningDark">#FFFFC46D</Color>
    <Color x:Key="ColorErrorDark">#FFFF7B7B</Color>

    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource ColorPrimaryDark}"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource ColorAccentDark}"/>
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource ColorBackgroundDark}"/>
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource ColorSurfaceDark}"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource ColorBorderDark}"/>
    <SolidColorBrush x:Key="TextPrimaryDarkBrush" Color="{StaticResource ColorTextPrimaryDark}"/>
    <SolidColorBrush x:Key="TextSecondaryDarkBrush" Color="{StaticResource ColorTextSecondaryDark}"/>
    <SolidColorBrush x:Key="SuccessDarkBrush" Color="{StaticResource ColorSuccessDark}"/>
    <SolidColorBrush x:Key="WarningDarkBrush" Color="{StaticResource ColorWarningDark}"/>
    <SolidColorBrush x:Key="ErrorDarkBrush" Color="{StaticResource ColorErrorDark}"/>

</ResourceDictionary>