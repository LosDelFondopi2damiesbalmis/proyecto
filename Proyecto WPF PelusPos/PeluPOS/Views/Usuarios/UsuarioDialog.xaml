<Window x:Class="PeluPOS.Views.Usuarios.UsuarioDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PeluPOS.Views.Usuarios"
        mc:Ignorable="d"
        Title="UsuarioDialog" Height="480" Width="500"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0 0 0 14">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Rellena los datos del usuario."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Nombre de usuario -->
                <StackPanel Grid.Row="0" Margin="0 0 0 10">
                    <TextBlock Text="Nombre de usuario"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Height="34"
                             Text="{Binding VM.NombreUsuario, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"/>
                </StackPanel>

                <!-- Contraseña (solo CREATE) -->
                <StackPanel Grid.Row="1" Margin="0 0 0 10"
                            Visibility="{Binding PasswordVisibility}">
                    <TextBlock Text="Contraseña"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <PasswordBox Height="34"
                                 x:Name="PasswordBox"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,0"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                </StackPanel>

                <!-- Rol -->
                <StackPanel Grid.Row="2" Margin="0 0 0 10">
                    <TextBlock Text="Rol"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox Height="34"
                              ItemsSource="{Binding VM.Roles}"
                              SelectedItem="{Binding VM.RolSeleccionado}"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"/>
                </StackPanel>

                <!-- Empleado vinculado (opcional) -->
                <StackPanel Grid.Row="3" Margin="0 0 0 10">
                    <TextBlock Text="Empleado vinculado (opcional)"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox Height="34"
                              ItemsSource="{Binding VM.Empleados}"
                              SelectedItem="{Binding VM.EmpleadoSeleccionado}"
                              DisplayMemberPath="nombre"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"/>
                </StackPanel>

                <!-- Error -->
                <TextBlock Grid.Row="4"
                           Text="{Binding VM.Error}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancelar"
                    Width="110" Height="38"
                    Margin="0,0,10,0"
                    Click="Cancelar_Click"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"/>
            <Button Content="Guardar"
                    Width="110" Height="38"
                    Click="Guardar_Click"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource TextPrimaryDarkBrush}"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
