<Window x:Class="PeluPOS.Views.Clientes.ClienteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ClienteDialog" Height="380" Width="480"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0 0 0 14">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Rellena los datos del cliente."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Nombre -->
                <StackPanel Grid.Row="0" Margin="0 0 0 10">
                    <TextBlock Text="Nombre *"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Height="34"
                             Text="{Binding VM.Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"/>
                </StackPanel>

                <!-- Teléfono -->
                <StackPanel Grid.Row="1" Margin="0 0 0 10">
                    <TextBlock Text="Teléfono"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Height="34"
                             Text="{Binding VM.Telefono, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"/>
                </StackPanel>

                <!-- Deuda -->
                <StackPanel Grid.Row="2" Margin="0 0 0 10">
                    <TextBlock Text="Deuda (€)"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Height="34"
                             Text="{Binding VM.Deuda, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"/>
                </StackPanel>

                <!-- Error -->
                <TextBlock Grid.Row="3"
                           Text="{Binding VM.Error}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancelar"
                    Width="110" Height="38"
                    Margin="0,0,10,0"
                    Click="Cancelar_Click"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"/>

            <Button Content="Guardar"
                    Width="110" Height="38"
                    Click="Guardar_Click"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource TextPrimaryDarkBrush}"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
