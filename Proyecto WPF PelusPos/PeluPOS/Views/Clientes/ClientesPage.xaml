<Page x:Class="PeluPOS.Views.ClientesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PeluPOS.Views"
      xmlns:conv="clr-namespace:PeluPOS.Resources.Converters"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientesPage" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Page.Resources>
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNullOrEmptyToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título, descripción y botón Nuevo -->
        <Grid Grid.Row="0" Margin="0 0 0 16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Clientes"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Gestiona tus clientes y búscalos rápidamente por nombre."
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>

            <!-- Botón Nuevo Cliente -->
            <Button Grid.Column="1"
                    Content="+ Nuevo Cliente"
                    Width="150" Height="38"
                    VerticalAlignment="Center"
                    Click="NuevoCliente_Click"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource TextPrimaryDarkBrush}"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>
        </Grid>

        <!-- Tarjeta principal -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="12"
                Padding="16"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de búsqueda -->
                <Grid Grid.Row="0" Margin="0 0 0 12">
                    <TextBox VerticalContentAlignment="Center"
                             Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Background="{DynamicResource BackgroundBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,6">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8">
                                                <ScrollViewer x:Name="PART_ContentHost"
                                                              Margin="4,0" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Text="Buscar por nombre…"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="14,0,0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding TextoBusqueda,
                                                    Converter={StaticResource StringNullOrEmptyToVisibilityConverter}}"/>
                </Grid>

                <!-- Lista de clientes -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding ClientesFiltrados}"
                          SelectedItem="{Binding ClienteSeleccionado}"
                          BorderThickness="0"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Padding" Value="8"/>
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter Margin="4"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="Background"
                                                        Value="{DynamicResource BackgroundBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="BorderBrush"
                                                        Value="{DynamicResource PrimaryBrush}"/>
                                                <Setter TargetName="Bd"
                                                        Property="BorderThickness"
                                                        Value="1.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Info del cliente -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nombre}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Telefono}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <!-- Deuda -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Deuda, StringFormat='Deuda: {0:C}'}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="0,0,16,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <!-- Botón Editar -->
                                <Button Grid.Column="2"
                                        Content="✏"
                                        ToolTip="Editar cliente"
                                        Width="32" Height="32"
                                        Margin="0,0,6,0"
                                        Tag="{Binding}"
                                        Click="EditarCliente_Click"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        FontSize="14"/>

                                <!-- Botón Eliminar -->
                                <Button Grid.Column="3"
                                        Content="🗑"
                                        ToolTip="Eliminar cliente"
                                        Width="32" Height="32"
                                        Tag="{Binding}"
                                        Click="EliminarCliente_Click"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource ErrorBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        FontSize="14"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

    </Grid>
</Page>
