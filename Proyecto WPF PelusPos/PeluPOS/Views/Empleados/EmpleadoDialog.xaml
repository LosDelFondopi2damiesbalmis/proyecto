<Window x:Class="PeluPOS.Views.Empleados.EmpleadoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PeluPOS.Views.Empleados"
        mc:Ignorable="d"
        Title="EmpleadoDialog" Height="520" Width="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0 0 0 14">
            <TextBlock Text="{Binding DialogTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Rellena los datos del empleado."
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Form -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Nombre -->
                <StackPanel Grid.Row="0" Margin="0 0 0 10">
                    <TextBlock Text="Nombre"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Height="34"
                             Text="{Binding VM.Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"/>
                </StackPanel>

                <!-- Teléfono + Cargo -->
                <Grid Grid.Row="1" Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Teléfono"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Height="34"
                                 Text="{Binding VM.Telefono, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cargo"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Height="34"
                                 Text="{Binding VM.Cargo, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"
                                 BorderThickness="1"
                                 Padding="10,0"/>
                    </StackPanel>
                </Grid>

                <!-- Email -->
                <StackPanel Grid.Row="2" Margin="0 0 0 10">
                    <TextBlock Text="Email"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Height="34"
                             Text="{Binding VM.Email, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"/>
                </StackPanel>

                <!-- Local -->
                <StackPanel Grid.Row="3" Margin="0 0 0 10">
                    <TextBlock Text="Local"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ComboBox Height="34"
                              ItemsSource="{Binding VM.Locales}"
                              SelectedItem="{Binding VM.LocalSeleccionado}"
                              DisplayMemberPath="Nombre"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1"/>
                </StackPanel>

                <!-- Password (solo en CREATE) -->
                <StackPanel Grid.Row="4" Margin="0 0 0 10"
                            Visibility="{Binding PasswordVisibility}">
                    <TextBlock Text="Contraseña"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Height="34"
                             Text="{Binding VM.Password, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"/>
                </StackPanel>

                <!-- Error -->
                <TextBlock Grid.Row="5"
                           Text="{Binding VM.Error}"
                           Foreground="{DynamicResource ErrorBrush}"
                           FontSize="12"
                           Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Cancelar"
                    Width="110" Height="38"
                    Margin="0,0,10,0"
                    Click="Cancelar_Click"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"/>

            <Button Content="Guardar"
                    Width="110" Height="38"
                    Click="Guardar_Click"
                    Background="{DynamicResource PrimaryBrush}"
                    Foreground="{DynamicResource TextPrimaryDarkBrush}"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
