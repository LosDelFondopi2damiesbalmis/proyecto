<Page x:Class="PeluPOS.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:conv="clr-namespace:PeluPOS.Resources.Converters"
      mc:Ignorable="d" Title="Dashboard" Background="#F7F9FC">
    <Page.Resources>
        <DropShadowEffect x:Key="Sh" BlurRadius="14" ShadowDepth="2" Direction="270" Color="#000" Opacity="0.07"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource Sh}"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoading, Converter={StaticResource InvBool}}">
            <StackPanel Margin="28,24,28,28">
                <!-- Cabecera -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Foreground="#1E1E2E"/>
                        <TextBlock Text="Resumen de actividad del salón" FontSize="13" Foreground="#6E7A8A" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="14,9"
                            BorderBrush="#E5E9F2" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DateLabel" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                    </Border>
                </Grid>

                <!-- Error -->
                <Border Background="#FFF0F0" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="13"/>
                </Border>

                <!-- KPIs -->
                <UniformGrid Rows="1" Margin="0,0,0,20">
                    <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                        <Grid>
                            <Border Height="4" Background="#5B8DEF" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="VENTAS HOY" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6"/>
                                <TextBlock Text="{Binding VentasHoy}" FontSize="30" FontWeight="Bold" Foreground="#1E1E2E" Margin="0,4,0,6"/>
                                <TextBlock Text="Facturas del día" FontSize="11" Foreground="#3B6FD4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                        <Grid>
                            <Border Height="4" Background="#4ECDC4" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="IMPORTE HOY" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6"/>
                                <TextBlock Text="{Binding ImporteHoy}" FontSize="30" FontWeight="Bold" Foreground="#1E1E2E" Margin="0,4,0,6"/>
                                <TextBlock Text="Total facturado" FontSize="11" Foreground="#1A9E96"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                        <Grid>
                            <Border Height="4" Background="#FFB347" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="CLIENTES HOY" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6"/>
                                <TextBlock Text="{Binding ClientesHoy}" FontSize="30" FontWeight="Bold" Foreground="#1E1E2E" Margin="0,4,0,6"/>
                                <TextBlock Text="Clientes únicos" FontSize="11" Foreground="#C07A10"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                        <Grid>
                            <Border Height="4" Background="#FF6B6B" CornerRadius="12,12,0,0" VerticalAlignment="Top"/>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="STOCK BAJO" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6"/>
                                <TextBlock Text="{Binding StockBajo}" FontSize="30" FontWeight="Bold" Foreground="#1E1E2E" Margin="0,4,0,6"/>
                                <TextBlock Text="⚠ Requiere atención" FontSize="11" Foreground="#C62828"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Contenido inferior -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Últimas ventas -->
                    <Border Grid.Column="0" Background="White" CornerRadius="12" Effect="{StaticResource Sh}" ClipToBounds="True">
                        <StackPanel>
                            <StackPanel Margin="20,16,20,12">
                                <TextBlock Text="Últimas ventas" FontSize="14" FontWeight="SemiBold" Foreground="#1E1E2E"/>
                                <TextBlock Text="Transacciones recientes" FontSize="12" Foreground="#8A94A6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Grid Margin="20,0,20,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HORA" FontSize="11" FontWeight="SemiBold" Foreground="#9AA3AF"/>
                                <TextBlock Grid.Column="1" Text="CLIENTE" FontSize="11" FontWeight="SemiBold" Foreground="#9AA3AF"/>
                                <TextBlock Grid.Column="2" Text="CONCEPTO" FontSize="11" FontWeight="SemiBold" Foreground="#9AA3AF"/>
                                <TextBlock Grid.Column="3" Text="TOTAL" FontSize="11" FontWeight="SemiBold" Foreground="#9AA3AF" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding UltimasVentas}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="20,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Hora}" FontSize="13" Foreground="#374151"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Cliente}" FontSize="13" FontWeight="SemiBold" Foreground="#1E1E2E"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Concepto}" FontSize="13" Foreground="#374151"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Total}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="20,4,20,12" FontSize="12" Foreground="#9AA3AF" FontStyle="Italic"
                                       Text="Sin ventas registradas."
                                       Visibility="{Binding HasVentas, Converter={StaticResource InvBool}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Top empleados -->
                    <Border Grid.Column="2" Background="White" CornerRadius="12" Effect="{StaticResource Sh}" ClipToBounds="True">
                        <StackPanel>
                            <StackPanel Margin="20,16,20,12">
                                <TextBlock Text="Top empleados" FontSize="14" FontWeight="SemiBold" Foreground="#1E1E2E"/>
                                <TextBlock Text="Rendimiento del mes" FontSize="12" Foreground="#8A94A6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding TopEmpleados}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="20,4" Padding="12" Background="#F8FAFF" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#1E1E2E">
                                                        <Run Text="{Binding Puesto}"/>
                                                        <Run Text="{Binding Nombre}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding NumServicios}" FontSize="11" Foreground="#8A94A6"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TotalImporte}" FontSize="13" FontWeight="Bold" Foreground="#5B8DEF" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="20,4,20,12" FontSize="12" Foreground="#9AA3AF" FontStyle="Italic"
                                       Text="Sin datos de empleados este mes."
                                       Visibility="{Binding HasEmpleados, Converter={StaticResource InvBool}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Overlay de carga -->
        <Border Background="#99FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Cargando datos…" FontSize="16" FontWeight="SemiBold"
                           Foreground="#5B8DEF" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
