<Page x:Class="PeluPOS.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PeluPOS.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DashboardPage" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Background="{DynamicResource MaterialDesignPaper}"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Grid Background="#F3F4F6" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Dashboard general"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#111827"/>
            <TextBlock Text="Resumen de ventas, empleados y stock"
                       FontSize="12"
                       Foreground="#6B7280"/>
        </StackPanel>

        <!-- GRID 2x2 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ESTILO TARJETAS -->
            <Grid.Resources>
                <Style x:Key="Card" TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="6"
                                              ShadowDepth="1"
                                              Opacity="0.1"/>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="CardTitle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Foreground" Value="#111827"/>
                </Style>
            </Grid.Resources>

            <!-- 🔹 ARRIBA IZQUIERDA: Últimas ventas -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Últimas ventas"
                               Style="{StaticResource CardTitle}"/>

                    <ListView Grid.Row="1" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Hora" Width="60"/>
                                <GridViewColumn Header="Cliente" Width="120"/>
                                <GridViewColumn Header="Servicio" Width="120"/>
                                <GridViewColumn Header="Importe" Width="70"/>
                            </GridView>
                        </ListView.View>

                        <!-- Datos de prueba -->
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="10:15" Width="70"/>
                                <TextBlock Text="Ana López" Width="140"/>
                                <TextBlock Text="Corte + tinte" Width="160"/>
                                <TextBlock Text="45,00 €" Width="80"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="10:45" Width="70"/>
                                <TextBlock Text="María Pérez" Width="140"/>
                                <TextBlock Text="Peinado evento" Width="160"/>
                                <TextBlock Text="35,00 €" Width="80"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="11:05" Width="70"/>
                                <TextBlock Text="Juan Ruiz" Width="140"/>
                                <TextBlock Text="Corte caballero" Width="160"/>
                                <TextBlock Text="18,00 €" Width="80"
                                           HorizontalAlignment="Right"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>

            <!-- 🔹 ARRIBA DERECHA: Empleados con más ventas -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Empleados con más ventas"
                               Style="{StaticResource CardTitle}"/>

                    <ListView Grid.Row="1" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Empleado" Width="130"/>
                                <GridViewColumn Header="Servicios" Width="70"/>
                                <GridViewColumn Header="Importe total" Width="90"/>
                            </GridView>
                        </ListView.View>

                        <!-- Datos de prueba -->
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Laura" Width="160"/>
                                <TextBlock Text="18" Width="80"/>
                                <TextBlock Text="420,00 €" Width="100"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Marta" Width="160"/>
                                <TextBlock Text="15" Width="80"/>
                                <TextBlock Text="380,00 €" Width="100"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Carlos" Width="160"/>
                                <TextBlock Text="12" Width="80"/>
                                <TextBlock Text="310,00 €" Width="100"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>

            <!-- 🔹 ABAJO IZQUIERDA: Ventas por local -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ventas por local"
                               Style="{StaticResource CardTitle}"/>

                    <ListView Grid.Row="1" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Local" Width="140"/>
                                <GridViewColumn Header="Hoy" Width="80"/>
                                <GridViewColumn Header="Este mes" Width="90"/>
                            </GridView>
                        </ListView.View>

                        <!-- Datos de prueba -->
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Centro Alicante" Width="180"/>
                                <TextBlock Text="12 ventas" Width="100"/>
                                <TextBlock Text="1.250,00 €" Width="100"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="San Juan Playa" Width="180"/>
                                <TextBlock Text="8 ventas" Width="100"/>
                                <TextBlock Text="780,00 €" Width="100"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Elche Centro" Width="180"/>
                                <TextBlock Text="10 ventas" Width="100"/>
                                <TextBlock Text="1.050,00 €" Width="100"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>

            <!-- 🔹 ABAJO DERECHA: Productos con stock bajo -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Productos con stock bajo"
                               Style="{StaticResource CardTitle}"/>

                    <ListView Grid.Row="1" Margin="0,8,0,0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Producto" Width="160"/>
                                <GridViewColumn Header="Stock" Width="50"/>
                                <GridViewColumn Header="Punto pedido" Width="80"/>
                            </GridView>
                        </ListView.View>

                        <!-- Datos de prueba -->
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Champú cabello teñido 500ml" Width="200"/>
                                <TextBlock Text="3" Width="60"/>
                                <TextBlock Text="10" Width="90"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Mascarilla hidratante 250ml" Width="200"/>
                                <TextBlock Text="5" Width="60"/>
                                <TextBlock Text="12" Width="90"/>
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Laca fijación fuerte" Width="200"/>
                                <TextBlock Text="2" Width="60"/>
                                <TextBlock Text="8" Width="90"/>
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
