<Page x:Class="PeluPOS.Views.TPV.TpvPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PeluPOS.Views.TPV" 
      xmlns:vm="clr-namespace:PeluPOS.ViewModels.TPV"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TpvPage" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Page.DataContext>
        <vm:TpvViewModel/>
    </Page.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="PeluPOS · TPV"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- User area -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚙"
                        Width="36" Height="36"
                        Margin="0,0,8,0"
                        Click="Gear_Click"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>

                <Button Content="{Binding ActiveUserLabel}"
                        Height="36"
                        Padding="12,0"
                        Click="UserMenu_Click"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Ticket + Cobro -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Ticket"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,8"/>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Ticket}"
                              Background="Transparent"
                              BorderThickness="0">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PrecioUnitario, StringFormat=P.Unit: {0:0.00} €}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Subtotal, StringFormat=Subtotal: {0:0.00} €}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="−" Width="28" Height="28"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.DecCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"/>
                                            <TextBlock Text="{Binding Cantidad}"
                                                       Width="22"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Button Content="+" Width="28" Height="28"
                                                    Margin="6,0,6,0"
                                                    Command="{Binding DataContext.IncCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"/>
                                            <Button Content="🗑" Width="32" Height="28"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource ErrorBrush}"
                                                    Foreground="{DynamicResource TextPrimaryDarkBrush}"
                                                    BorderThickness="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="2"
                               Text="{Binding Total, StringFormat=TOTAL: {0:0.00} €}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,6,0,6"/>

                    <!-- Pago -->
                    <StackPanel Grid.Row="3" Margin="0,4,0,6">
                        <TextBlock Text="Tipo de pago"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <ComboBox Height="26"
                                  ItemsSource="{Binding TiposPago}"
                                  SelectedItem="{Binding TipoPago}"
                                  Background="{DynamicResource BackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"/>

                        <CheckBox Content="Pendiente de pago"
                                  IsChecked="{Binding Pendiente}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,8,0,0"/>
                        <TextBlock Text="Cliente asignado"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ComboBox Height="26"
                                  ItemsSource="{Binding Clientes}"
                                  SelectedItem="{Binding ClienteSeleccionado}"
                                  Background="{DynamicResource BackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4"
                               Text="{Binding Error}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="12"
                               Margin="0,0,0,6"/>
                </Grid>
            </Border>

            <!-- Catálogo -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toggle Productos/Servicios -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Productos"
                                Width="120" Height="36"
                                Margin="0,0,10,0"
                                Click="Productos_Click"
                                Background="{DynamicResource PrimaryBrush}"
                                Foreground="{DynamicResource TextPrimaryDarkBrush}"
                                BorderThickness="0"/>
                        <Button Content="Servicios"
                                Width="120" Height="36"
                                Click="Servicios_Click"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                BorderThickness="0"/>
                    </StackPanel>

                    <!-- Buscador -->
                    <TextBox Grid.Row="1"
                             Height="34"
                             Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="1"
                             Padding="10,0"
                             Margin="0,0,0,10"/>

                    <!-- Grid de items (iconos grandes) -->
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="190" Height="110"
                                            Margin="0,0,10,10"
                                            Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource BackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="🧾"
                                                       FontSize="24"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>

                                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Nombre}"
                                                           TextWrapping="Wrap"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Precio, StringFormat={}{0:0.00} €}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Cobrar -->
                    <Button Grid.Row="3"
                            Content="COBRAR"
                            Height="52"
                            Margin="0,12,0,0"
                            Click="Cobrar_Click"
                            Background="{DynamicResource SuccessBrush}"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderThickness="0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
