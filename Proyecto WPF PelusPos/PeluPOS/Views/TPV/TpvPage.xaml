<Page x:Class="PeluPOS.Views.TPV.TpvPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:PeluPOS.Views.TPV"
      xmlns:vm="clr-namespace:PeluPOS.ViewModels.TPV"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TpvPage"
      Background="{DynamicResource MaterialDesignPaper}"
      TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Page.DataContext>
        <vm:TpvViewModel/>
    </Page.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="PeluPOS · TPV"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⚙"
                        Padding="5" MinWidth="36" MinHeight="36"
                        Margin="0,0,8,0"
                        Click="Gear_Click"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>
                <Button Content="{Binding ActiveUserLabel, RelativeSource={RelativeSource AncestorType=Page}}"
                        Padding="12,8" MinHeight="36"
                        Click="UserMenu_Click"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>
            </StackPanel>
        </Grid>

        <!-- Main content: left ticket panel + right catalog panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="500"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ PANEL IZQUIERDO: Ticket + Cobro ═══════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: título + botón Nuevo ticket -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ticket"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="🗑 Nuevo ticket"
                                Padding="10,6" Height="32" FontSize="12"
                                Command="{Binding NuevoTicketCommand}"
                                Background="{DynamicResource ErrorBrush}"
                                Foreground="White" BorderThickness="0"/>
                    </Grid>

                    <!-- Líneas del ticket -->
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Ticket}"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10"
                                        Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Nombre}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding PrecioUnitario, StringFormat=Precio: {0:0.00} €}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Subtotal, StringFormat=Subtotal: {0:0.00} €}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- Controles cantidad (36×36) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="−" Width="36" Height="36" Margin="0,0,4,0" FontSize="14"
                                                    Command="{Binding DataContext.DecCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            <TextBlock Text="{Binding Cantidad}"
                                                       Width="24" TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Button Content="+" Width="36" Height="36" Margin="4,0,4,0" FontSize="14"
                                                    Command="{Binding DataContext.IncCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                            <Button Content="🗑" Width="36" Height="36"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource ErrorBrush}"
                                                    Foreground="White" BorderThickness="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Total -->
                    <TextBlock Grid.Row="2"
                               Text="{Binding Total, StringFormat=TOTAL: {0:0.00} €}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,8,0,8"/>

                    <!-- Pago -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,8">
                        <TextBlock Text="Tipo de pago"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox Height="32"
                                  ItemsSource="{Binding TiposPago}"
                                  SelectedItem="{Binding TipoPago}"
                                  Background="{DynamicResource BackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                        <CheckBox Content="Pendiente de pago"
                                  IsChecked="{Binding Pendiente}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,8,0,8"/>
                        <TextBlock Text="Cliente"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,4"/>
                        <ComboBox Height="32"
                                  ItemsSource="{Binding Clientes}"
                                  SelectedItem="{Binding ClienteSeleccionado}"
                                  DisplayMemberPath="Nombre"
                                  Background="{DynamicResource BackgroundBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                    </StackPanel>

                    <!-- Error (justo encima del botón COBRAR) -->
                    <TextBlock Grid.Row="4"
                               Text="{Binding Error}"
                               Foreground="{DynamicResource ErrorBrush}"
                               FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <!-- COBRAR -->
                    <Button Grid.Row="5"
                            Content="✔  COBRAR"
                            Height="52" FontSize="16" FontWeight="Bold"
                            Click="Cobrar_Click"
                            Background="{DynamicResource SuccessBrush}"
                            Foreground="White" BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- ═══════════ PANEL DERECHO: Catálogo ═══════════ -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toggle Productos / Servicios con estado visual activo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

                        <Button Content="Productos"
                                Width="130" Height="38" Margin="0,0,8,0"
                                Click="Productos_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModoProductos}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Servicios"
                                Width="130" Height="38"
                                Click="Servicios_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ModoProductos}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                    <!-- Buscador con placeholder -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox Height="36"
                                 Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{DynamicResource BackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 Padding="10,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="🔍  Buscar producto o servicio..."
                                   IsHitTestVisible="False"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Busqueda}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Catálogo -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="130" Height="80" Margin="4"
                                        Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Nombre}"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   MaxWidth="120"/>
                                        <TextBlock Text="{Binding Precio, StringFormat={}{0:0.00} €}"
                                                   TextAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
